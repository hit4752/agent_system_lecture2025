# Paths are relative to the workspace src directory.
# lecture2025 is already cloned; do not fetch a second copy of it.
- git:
    local-name: choreonoid
    uri: https://github.com/choreonoid/choreonoid.git
    version: release-2.2
- git:
    local-name: choreonoid/ext/vnoid
    uri: https://github.com/ytazz/vnoid.git
    version: main
- git:
    local-name: choreonoid/ext/jaxon2_sample
    uri: https://github.com/choreonoid/jaxon2-draft.git
    version: main
- git:
    local-name: simple_bipedal
    uri: https://github.com/hit4752/simple_bipedal.git
    version: master
