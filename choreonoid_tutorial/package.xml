<?xml version="1.0"?>
<package format="2">
  <name>choreonoid_tutorial</name>
  <version>1.0.0</version>
  <description>
    Tutorial on how to implement a robot controller in choreonoid
  </description>
  <maintainer email="k-kojima@jsk.imi.i.u-tokyo.ac.jp">Kunio Kojima</maintainer>
  <license>MIT</license>
  <author email="k-kojima@jsk.imi.i.u-tokyo.ac.jp">Kunio Kojima</author>
  <url type="repository">https://github.com/agent-system/lecture2025</url>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <depend>choreonoid</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>

  <build_export_depend>message_runtime</build_export_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>simple_bipedal</exec_depend>
  <exec_depend>ffmpeg</exec_depend>
  <!-- LibTorch is found by CMake (Torch_DIR); no rosdep key is available.
       See ../README.md for installation and ABI requirements. -->

  <export/>
</package>
